<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:text="CallBridge Server"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvConnectionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:padding="10dp"
        android:background="#FFF3E0"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvBtListenStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:gravity="center"
        android:textColor="#888888"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnSetDialer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set as Default Dialer"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnStartService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Bridge Service"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnBatteryFix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Fix Battery Optimization"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnRestartApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 Force Restart App"
        android:backgroundTint="#FF7043"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Make sure Bluetooth is ON and Phone B is paired with this phone. Start Bridge Service, then connect from Phone B."
        android:textSize="13sp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#888888" />

</LinearLayout>
